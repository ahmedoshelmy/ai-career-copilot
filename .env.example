# ==============================================================================
# AI Career Copilot — Environment Configuration
# Copy this file to '.env' and fill in your API key(s)
# ==============================================================================

# --- Groq (Default LLM Provider for Fast Real-Time Inference) ---
# Get your free Groq API key: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- Hugging Face (Required for Serverless Embeddings Endpoint) ---
# Get your free user access token: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=hf_your_huggingface_token_here

# --- Optional: Local / Cloud Ollama Provider ---
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_BASE_URL=http://localhost:11434
